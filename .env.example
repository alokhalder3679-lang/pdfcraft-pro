# PDFCraft Pro Environment Configuration

VITE_APP_TITLE=PDFCraft Pro
VITE_APP_DESCRIPTION=Modern All-in-One Client-Side PDF Tools Platform

# Production & Custom Domains (Curated from free-for-dev)
# Primary: https://pdfcraft-pro.vercel.app/
# Custom Subdomain: https://pdfcraft-pro.is-a.dev/
# Secondary: https://pdfcraft.js.org/

# Free Email Service - Web3Forms (250 free submissions/month, zero backend required)
# Get a free key instantly at https://web3forms.com
VITE_WEB3FORMS_ACCESS_KEY=

# Optional: EmailJS (200 free client-side emails/month from free-for-dev)
# https://www.emailjs.com/
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=

# Optional: Provide Google Gemini API key for enhanced AI Summarization & Document Translation
VITE_GEMINI_API_KEY=

# Default OCR / Translation Language
VITE_DEFAULT_LANGUAGE=en
